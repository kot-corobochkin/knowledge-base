# macOS
.DS_Store
.localized

# Obsidian cache and workspace (часто ломают синхронизацию)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/

# В твоём случае (если vault в папке Main)
Main/.obsidian/workspace.json
Main/.obsidian/workspace-mobile.json
Main/.obsidian/cache/

# данные плагинов (часто меняются)
.obsidian/plugins/*/data.json

# Python (у тебя есть .venv)
.venv/
__pycache__/
*.pyc

# временные файлы редакторов
*.swp
*.tmp